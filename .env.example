# Added in Issue #2. Server-only Postgres connection string (Neon pooled
# connection string from the Neon dashboard's Connect panel).
DATABASE_URL=

# Added in Issue #7. GitHub OAuth App credentials for admin sign-in
# (https://github.com/settings/developers), and the secret Auth.js uses to
# sign the session cookie (generate with `npx auth secret`).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=

# Added in Issue #7. Only this GitHub username may access /admin — anyone
# else who signs in with GitHub is denied.
ADMIN_GITHUB_USERNAME=

# Added in Issue #9. Vercel Blob read/write token for photo uploads. Vercel
# sets this automatically for connected projects; only needed manually for
# local dev.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_CARTO_API_KEY=
