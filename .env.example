# Added in Issue #2. Server-only Postgres connection string (Neon pooled
# connection string from the Neon dashboard's Connect panel).
DATABASE_URL=

# Added in Issue #7. Shared admin password gating the /admin route.
ADMIN_PASSWORD=

# Added in Issue #7. Long random string used to sign the admin session
# cookie, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# Added in Issue #9. Vercel Blob read/write token for photo uploads. Vercel
# sets this automatically for connected projects; only needed manually for
# local dev.
BLOB_READ_WRITE_TOKEN=
